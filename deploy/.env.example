# ============================================================
# 复制成 .env 后逐项填。下面这几条命令生成随机密钥：
#   openssl rand -hex 32     → CREDS_KEY / JWT_SECRET / JWT_REFRESH_SECRET / POSTGRES_PASSWORD
#   openssl rand -hex 16     → CREDS_IV
# ============================================================

# ---- 站点 ----
DOMAIN=chat.example.com
ACME_EMAIL=you@example.com
# 主站品牌名（浏览器标签、登录页、邮件抬头）
APP_TITLE=知猪

# ---- LibreChat 加密与登录 ----
# ★ 这四项一旦上线就不要再改：改了等于所有人掉登录 +
#   数据库里加密的厂商 Key 全部解不开（表现为"所有模型 401"）。
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- 内部服务密钥 ----
BRAIN_API_KEY=sk-brain-internal

# ---- 运营后台（/console）----
# 首次启动用这组账号密码建 owner，之后可以在后台里改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 另一个入口 /admin（只管模型）用的口令；留空 = 该入口彻底关闭
ADMIN_TOKEN=
# 加密存在数据库里的厂商 Key；留空则用 JWT_SECRET 派生
SECRET_KEY=

# ---- 数据库 ----
POSTGRES_PASSWORD=
# 后台读 LibreChat 的 Mongo（用户追踪用）。容器网络里就是服务名
MONGO_URL=mongodb://mongodb:27017/LibreChat

# ============================================================
# 注册口径
# ============================================================
# 唯一的注册方式是「后台生成邀请码」。Caddy 把 /api/auth/register 转到 brain，
# 校验邀请码 + 人机验证之后才转发给 LibreChat。
ALLOW_REGISTRATION=true
# 没有邮件服务，所以放行未验证邮箱登录；注册口由邀请码把关
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# Cloudflare Turnstile（注册防刷）。留空 = 不启用（仍要邀请码）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ============================================================
# 记忆与压缩（改这些不用改代码）
# ============================================================
# 所有"杂活"（抽取/摘要/标题）走这个别名，改一处就能全站换更便宜的模型。
#   · 精简版（直连上游）填 brain/models.json 里的别名
CHEAP_MODEL=qwen-flash

# 上下文总预算，超了就触发滚动摘要。这是省钱的总闸门，不是体验参数
HISTORY_BUDGET_TOKENS=8000
KEEP_RECENT_TURNS=8
MEMORY_TOP_K=8
# 攒够多少条记忆变动就自动重算画像。0 = 关掉自动更新
PROFILE_REFRESH_EVERY=8

# 压缩：1=启用。关掉后只剩结构裁剪
COMPRESS_ENABLED=1
COMPRESS_RATIO=0.6

# 可选增强（镜像会变大，默认关）：
#   WITH_COMPRESS=1  → 装 LLMLingua-2（+torch，约 1.2GB 镜像）
#   WITH_MEM0=1      → 装 Mem0 引擎；还要同时把 MEM0_ENABLED 设成 1
WITH_COMPRESS=0
WITH_MEM0=0
MEM0_ENABLED=0

# 调试：允许用 X-Debug-User 头绕过 JWT（仅本机调试，生产必须 0）
BRAIN_DEBUG=0

# ============================================================
# 模型 Key
# 填了哪家，管理后台的模型页里就只有哪家可选；没填的别名会被自动跳过。
# 也可以完全不填这里，改成在 /console#/models 里逐家录入（存在数据库里）
# ============================================================
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
HUNYUAN_API_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ============================================================
# 可选：腾讯 IMA 知识库（后台「AI 管理」把站内数据整理成文档推进去，提问时走它检索）
# 凭证在 https://ima.qq.com/agent-interface 拿；知识库需要先在 IMA 客户端里建好
# ============================================================
IMA_CLIENT_ID=
IMA_API_KEY=
# 默认选中的知识库名（后台下拉会自动匹配同名的那一个）
IMA_KB_NAME=my-knowledge-base

# ============================================================
# 可选：Umami 统计（自建，无 cookie）
# 主站 index.html 在生成时注入，后台在响应时注入；两者都读这两个变量。
# 留空 = 完全不埋点。
# ============================================================
UMF_UMAMI_SRC=
UMF_UMAMI_ID=

# ============================================================
# 可选：Cloudflare Tunnel（不想开放 80/443、或跑在家里 NAS 时用）
# 在 CF 控制台 Zero Trust → Tunnels 建一条，把 token 填这里，然后
#   docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d
# ============================================================
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================================
# 头像存储（可选但推荐）：Cloudflare R2
# 填全这四项就自动走 R2（零出口费 + 全球缓存）；不填则落在 brain_data 卷，
# 由 brain 自己发 /api/umf/avatar/file/*，功能一样，只是没有边缘缓存。
#   R2_ACCOUNT_ID        Cloudflare 后台右下角 Account ID
#   R2_API_TOKEN         只对目标桶有读写权的 API Token（cfut_ 开头）
#   R2_BUCKET            桶名
#   R2_JURISDICTION      账号所在区域，多数是 default（对象接口必须带，否则 401）
#   R2_PUBLIC_BASE       桶的公开域名，例如 https://img.example.com（结尾不带 /）
# ============================================================
R2_ACCOUNT_ID=
R2_API_TOKEN=
R2_BUCKET=umf-avatars
R2_JURISDICTION=default
R2_PUBLIC_BASE=
